# GLOBAL ENVIRONMENT VARIABLES

## App origin for OAuth return — used to build redirectTo on the server
### Local: http://localhost:3000 
### Vercel/deployment: e.g. https://<your-live.host>.vercel.app
SITE_URL=http://localhost:3000

## Optional custom URL paths, no trailing slash (defaults shown)
### Example nested install: board at /guestbook, admin at /guestbook/admin
NEXT_PUBLIC_GUESTBOOK_PATH=/
NEXT_PUBLIC_GUESTBOOK_ADMIN_PATH=/admin


# SUPABASE ENVIRONMENT VARIABLES

## Supabase database password
### Used in to replace `[YOUR-PASSWORD]` in the `DATABASE_URL`
SUPABASE_DATABASE_PASSWORD=

## Supabase publishable API key (browser-safe, RLS still applies)
### Local + Vercel/deployment + GitHub Actions (if you choose to use `keep-alive`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Service role API key
### Local ONLY — for `npx y2k-guestbook allow-admin` / `npx y2k-guestbook delete-admin`
SUPABASE_SERVICE_ROLE_KEY=

## Supabase project URL
### Local + Vercel/deployment + GitHub Actions (if you choose to use `keep-alive`)
### Example: https://[YOUR-PROJECT-ID].supabase.co
NEXT_PUBLIC_SUPABASE_URL=

## Supabase Postgres pooler URI for rate limiting
### Local + Vercel/deployment 
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

## Account access token for deploying Edge Functions for email notifications
SUPABASE_ACCESS_TOKEN=


# POSTHOG ANALYTICS

## Show hit counter
FLAG_COUNTER=false 
## Comma-separated paths/URLs for unique visitors (empty = all pages); public guestbook is /    
FLAG_COUNTER_URL=/
## UTC instant YYYY-MM-DDTHH:mm:ssZ (empty = all time)
### Example: 2026-09-12T00:00:00Z
FLAG_COUNTER_DATE=

## Personal key needs query:read only
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com

## Client tracking stays off until you copy instrumentation-client.ts.example → instrumentation-client.ts
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# GOOGLE ADMIN SSO 
## Not used by the application, but make sure to hang on to these just in case

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# GMAIL NOTIFICATIONS (SET IN SUPABASE ONLY)
## Set in Supabase only

### Not used by the application, but make sure the flag is set to `true` in Supabase
FLAG_NOTIF=false 
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
NOTIFY_WEBHOOK_SECRET=


