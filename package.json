{
  "name": "y2k-guestbook",
  "version": "0.1.0",
  "private": true,
  "description": "Drop-in y2k guestbook for Next.js App Router. Install from GitHub.",
  "bin": {
    "y2k-guestbook": "./scripts/cli.mjs"
  },
  "files": [
    "package",
    "src",
    "scripts/cli.mjs",
    "scripts/schema.sql",
    ".env.example",
    "instrumentation-client.ts.example"
  ],
  "exports": {
    ".": "./package/index.ts",
    "./proxy": "./package/proxy.ts",
    "./admin-login": "./package/admin-login.ts",
    "./callback": "./package/callback.ts",
    "./example-css": "./package/example-css.ts",
    "./hits": "./package/hits.ts",
    "./config": "./package/config.ts",
    "./styles.css": "./package/styles.css"
  },
  "scripts": {
    "dev": "next dev",
    "dev:stop": "node scripts/stop-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:a11y": "eslint src --no-config-lookup --config eslint.a11y.config.mjs",
    "allow-admin": "node scripts/cli.mjs allow-admin",
    "delete-admin": "node scripts/cli.mjs delete-admin",
    "test:cucumber": "npx cucumber-js",
    "test:cucumber:admin": "npx cucumber-js -p admin"
  },
  "peerDependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "dotenv": "^17.4.2",
    "obscenity": "^0.4.6",
    "pg": "^8.23.0",
    "rate-limiter-flexible": "^11.2.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "^1.63.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
